rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tripstak uses Sign in with Apple for identity but Firebase Auth is anonymous.
    // Documents are keyed by Apple user ID (dots → underscores), which does not match
    // Firebase Auth UID. We cannot do a strict uid == docId check. Instead we:
    //   1. Require the user to be Firebase-authenticated (anonymous sign-in covers this).
    //   2. Require the document ID to be non-empty and at least 8 chars (Apple IDs are long).
    //   3. Disallow writes that include obviously dangerous fields.

    match /user_profiles/{docId} {
      allow read: if request.auth != null
        && docId.size() >= 8;
      allow write: if request.auth != null
        && docId.size() >= 8
        && !('__proto__' in request.resource.data)
        && !('constructor' in request.resource.data);
    }

    // One-time app preview for Continue without account (keyed by hashed device ID).
    match /app_preview_devices/{docId} {
      allow read: if request.auth != null
        && docId.size() >= 8;
      allow write: if request.auth != null
        && docId.size() >= 8
        && !('__proto__' in request.resource.data)
        && !('constructor' in request.resource.data);
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
        && userId.size() >= 8;
      match /{subCollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    match /albums/{albumId} {
      allow read, write: if request.auth != null
        && albumId.size() > 0;
    }

    // Curated marketing photos (main carousel, list cards). Public read so the
    // first screen does not depend on anonymous auth finishing first.
    match /category_photos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Google Places photo caches (used by ViewPhotoService, RestaurantPhotoService, etc.)
    match /places_cache/{docId} {
      allow read, write: if request.auth != null;
    }
    match /photos_cache/{docId} {
      allow read, write: if request.auth != null;
    }
    match /venue_photos_cache/{docId} {
      allow read, write: if request.auth != null;
    }
    match /restaurant_photos_cache/{docId} {
      allow read, write: if request.auth != null;
    }
    match /cache_stats/{docId} {
      allow read, write: if request.auth != null;
    }
    match /venue_photo_refs/{docId} {
      allow read, write: if request.auth != null;
    }
    match /restaurant_enhancements/{docId} {
      allow read, write: if request.auth != null;
    }
    match /nightlife_enhancements/{docId} {
      allow read, write: if request.auth != null;
    }

    // Self-guided walk content, seeded and read by SelfGuidedWalksFirebaseService.
    match /selfGuidedWalks/{docId} {
      allow read, write: if request.auth != null;
    }
    match /walkCategories/{docId} {
      allow read, write: if request.auth != null;
    }

    // Public creator pages (bio, socials, mini-blog posts). Public read for
    // creators.trekstakapp.com. Writes require a verified creator session
    // (custom claim creatorSlug must match the document slug).
    match /creator_pages/{slug} {
      allow read: if true;
      allow write: if request.auth != null
        && slug.size() >= 2
        && slug.size() <= 64
        && request.auth.token.creatorSlug == slug
        && !('__proto__' in request.resource.data)
        && !('constructor' in request.resource.data);
    }

    // Creator registry — server-only (Cloud Functions Admin SDK).
    match /creator_registry/{docId} {
      allow read, write: if false;
    }

    // Private creator hub data (style profile, AI settings). Creator-scoped.
    match /creator_hub_private/{slug} {
      allow read: if request.auth != null
        && request.auth.token.creatorSlug == slug;
      allow write: if request.auth != null
        && request.auth.token.creatorSlug == slug
        && !('__proto__' in request.resource.data)
        && !('constructor' in request.resource.data);
    }

    // Creator AI usage counters — read own month doc; writes via Functions only.
    match /creator_ai_usage/{docId} {
      allow read: if request.auth != null
        && request.auth.token.creatorSlug != null
        && docId.matches('^' + request.auth.token.creatorSlug + '_[0-9]{4}-[0-9]{2}$');
      allow write: if false;
    }

    // Global AI config (limits, prompts metadata) — admin / Functions only.
    match /creator_ai_config/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
